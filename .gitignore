# Strict core-only export. Runtime outputs, data, tests, analysis and caches are excluded.
*
!/.gitignore
!/README.md
!/requirements.txt
!/configs/
!/configs/*.yaml
!/mmfi_wifi/
!/mmfi_wifi/*.py
!/pose_ssl/
!/pose_ssl/*.py
!/pose_ssl/metafi/
!/pose_ssl/metafi/*.py
!/pose_ssl/vit_ssl/
!/pose_ssl/vit_ssl/*.py
!/scripts/
!/scripts/run.py
!/scripts/report_results.py
!/scripts/metafi_ssl/
!/scripts/metafi_ssl/*.py
!/scripts/vit_ssl/
!/scripts/vit_ssl/*.py
!/scripts/reproduction/
!/scripts/reproduction/*.py
!/WIFIJEPA/
!/WIFIJEPA/__init__.py
!/WIFIJEPA/configs/
!/WIFIJEPA/configs/*.yaml
!/WIFIJEPA/src/
!/WIFIJEPA/src/*.py
!/WIFIJEPA/scripts/
!/WIFIJEPA/scripts/*.py
!/WIFIJEPA/cross_sence/
!/WIFIJEPA/cross_sence/*.py
!/WIFIJEPA/cross_sence/共享链路与连续时间方案总结.md
!/WIFIJEPA/cross_sence/configs/
!/WIFIJEPA/cross_sence/configs/*.yaml
!/dataset/
!/dataset/.gitkeep
!/result/
!/result/.gitkeep
